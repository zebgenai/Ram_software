# Copy to .env and fill in.  chmod 600 .env
PUBLIC_URL=https://files.clevercampus.cloud
COMPANY_NAME=Your Company Name
ADMIN_USER=admin
# Generate with:
#   docker run --rm -i remote-files-server:latest hash-password
# then paste the full line. Keep the single quotes ($ signs inside).
ADMIN_PASSWORD_HASH='pbkdf2-sha256$600000$REPLACE$REPLACE'

# --- OnlyOffice (in-browser Excel editing). Leave all three blank to disable. ---
# Browser-facing Document Server URL (its own subdomain on the same wildcard cert):
ONLYOFFICE_PUBLIC_URL=https://office.clevercampus.cloud
# Shared JWT secret — MUST match the onlyoffice service's JWT_SECRET in compose.
# Generate once: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=REPLACE_WITH_32_BYTE_HEX
# How the Document Server container reaches THIS server over the docker network:
INTERNAL_BASE_URL=http://remote-files-server:8080
